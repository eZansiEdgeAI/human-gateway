<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>HumanGateway.Relay.Tests</RootNamespace>
    <AssemblyName>HumanGateway.Relay.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.6.5" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- HTTP-level integration tests: boots the real Relay Program over WebApplicationFactory (the same
         pattern as HumanGateway.Edge.Tests/LocalApiEndpointTests) and a disposable PostgreSQL spun up by
         Testcontainers (cloud-relay §6: "Integration: Edge ↔ Relay over HTTP: Testcontainers: PostgreSQL"). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <!-- Aligns the transitive EF Core graph (Relay's Npgsql provider resolves an older patch than the
         Design package — which is PrivateAssets=all and does not flow to this project) so the test build
         emits no MSB3277 conflict warnings. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- StatusCodes and the ASP.NET Core surface used by the Relay's HTTP models. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/HumanGateway.Relay/HumanGateway.Relay.csproj" />
    <!-- Aliased so the Edge service's top-level-statement-generated global `Program` type does not collide
         with the Relay's own global `Program` type in this test assembly (identity-security §6: integration
         tests drive the real Edge registration client against the real Relay). -->
    <ProjectReference Include="../../src/HumanGateway.Edge/HumanGateway.Edge.csproj">
      <Aliases>edge</Aliases>
    </ProjectReference>
  </ItemGroup>

</Project>
