{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Edge": {
    "GatewayId": "edge:scaffold",
    "DataDirectory": "/var/lib/humangateway",
    "RelayBaseUrl": "https://relay.example.invalid"
  },
  "Sync": {
    "BatchSize": 100,
    "PollIntervalSeconds": 30,
    "Backoff": {
      "BaseDelaySeconds": 1,
      "MaxDelaySeconds": 300,
      "MaxAttempts": 8
    }
  }
}
