# HumanGateway full-stack compose environment overrides (optional).
# Copy to `.env` and edit, or export before `docker compose up`.
#
# Host port PostgreSQL is published on (internal to the compose network
# otherwise). Defaults to 127.0.0.1:5433 to avoid colliding with a dev DB on 5432.
HG_DB_PORT=127.0.0.1:5433
# Host port the Cloud Relay is published on.
HG_RELAY_PORT=5275
# Host port the Edge Gateway is published on.
HG_EDGE_PORT=8080
# Edge gateway identity (AUTH-FR-01).
HG_GATEWAY_ID=edge:compose

# TLS for Edge↔Relay traffic (AUTH-FR-04, SP-01): the Edge dials the Relay over https in production.
# The compose file sets Relay__AllowInsecureHttp=true for the internal dev network only — never enable
# plain-http Relay access outside a trusted dev/loopback topology.

# TLS for Edge↔Relay traffic (AUTH-FR-04, SP-01): the Edge refuses to dial the Relay over plain http except
# for loopback hosts or this explicit insecure-dev opt-in. The compose dev topology sets it true; Production
# must leave it unset so Relay__BaseUrl uses https.
HG_EDGE_ALLOW_INSECURE_RELAY=false

# Bootstrap user seeded at first boot for the Edge local login (AUTH-FR-02, SP-07).
# Credentials are supplied via the environment — a committed password is a release-blocker.
HG_EDGE_AUTH_BOOTSTRAP_USERNAME=
HG_EDGE_AUTH_BOOTSTRAP_PASSWORD=

# Bootstrap user for the Relay remote login gate (AUTH-FR-02, SP-07, external-web-access).
HG_RELAY_AUTH_BOOTSTRAP_USERNAME=
HG_RELAY_AUTH_BOOTSTRAP_PASSWORD=
