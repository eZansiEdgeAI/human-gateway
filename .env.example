# HumanGateway full-stack compose environment overrides (optional).
# Copy to `.env` and edit, or export before `docker compose up`.
#
# Host port PostgreSQL is published on (internal to the compose network
# otherwise). Defaults to 127.0.0.1:5433 to avoid colliding with a dev DB on 5432.
HG_DB_PORT=127.0.0.1:5433
# Host port the Cloud Relay is published on.
HG_RELAY_PORT=5275
# Host port the Edge Gateway is published on.
HG_EDGE_PORT=8080
# Edge gateway identity (AUTH-FR-01).
HG_GATEWAY_ID=edge:compose
