<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HumanGateway.Relay</RootNamespace>
    <AssemblyName>HumanGateway.Relay</AssemblyName>
    <Version>1.0.0</Version>
    <Description>The Cloud Relay: an ASP.NET Core service backed by PostgreSQL (message metadata + artifact bytes via BYTEA) that acts as the rendezvous point for Edge Gateway sync and cross-school message exchange (product vision §6.3, RELAY-FR-01..05).</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HumanGateway.Protocol/HumanGateway.Protocol.csproj" />
    <ProjectReference Include="../HumanGateway.Core/HumanGateway.Core.csproj" />
    <!-- Shared security primitives (AUTH-FR-02, SP-03): PHC password hashing + signed opaque session tokens. -->
    <ProjectReference Include="../HumanGateway.Security/HumanGateway.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PostgreSQL storage (RELAY-FR-01): Npgsql with EF Core for the durable Relay schema
         (gateways, conversations, messages, deliveries, artifacts, sync cursors) and the
         content-addressed BYTEA artifact store (ARTF-FR-01). -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
