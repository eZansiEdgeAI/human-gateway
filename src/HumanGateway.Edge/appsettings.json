{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Edge": {
    "GatewayId": "edge:scaffold",
    "DataDirectory": "/var/lib/humangateway",
    "RelayBaseUrl": "https://relay.example.invalid"
  },
  "Sync": {
    "BatchSize": 100,
    "PollIntervalSeconds": 30,
    "Backoff": {
      "BaseDelaySeconds": 1,
      "MaxDelaySeconds": 300,
      "MaxAttempts": 8
    }
  },
  "Relay": {
    "BaseUrl": "https://relay.example.invalid"
  },
  "Artifacts": {
    "MaxArtifactSizeBytes": 52428800,
    "QuotaBytes": 1073741824,
    "ChunkSizeBytes": 4194304
  },
  "Auth": {
    "BootstrapUser": {
      "Username": "",
      "Password": "",
      "DisplayName": ""
    }
  }
}
